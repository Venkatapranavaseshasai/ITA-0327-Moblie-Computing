rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    match /videos/{id} {
      allow read: if request.auth != null;
      allow write: if false; // Seed through the Admin SDK, never from a client.
    }
    match /users/{uid}/sessions/{sid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) && request.resource.data.sessionId == sid
        && request.resource.data.videoId is string && request.resource.data.totalStallCount is int
        && request.resource.data.totalStallCount >= 0 && request.resource.data.totalStallDurationMs >= 0;
      allow delete: if false;
      match /switches/{eid} {
        allow read: if owns(uid);
        allow create: if owns(uid) && request.resource.data.eventId == eid
          && request.resource.data.sessionId == sid && request.resource.data.kind in ['POLICY_CAP', 'VIDEO_OUTPUT'];
        allow update, delete: if false;
      }
    }
  }
}
